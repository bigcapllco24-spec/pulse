rules_version = '2';
// No personal data is stored. Each account is the document accounts/{uid} of a device's anonymous sign-in,
// and only that sign-in can read or change it. Listing collections is never allowed from the app.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(acct) { return request.auth != null && request.auth.uid == acct; }

    // Username: a public display name. Set once, then changed at most twice; every change must claim the
    // new name in /usernames in the same write, so names stay unique.
    function nameDoc(name) { return /databases/$(db)/documents/usernames/$(name); }
    function usernameOk(acct) {
      let before = resource.data.get('username', null);
      let after = request.resource.data.get('username', null);
      let n0 = resource.data.get('usernameChanges', 0);
      let n1 = request.resource.data.get('usernameChanges', 0);
      return (after == before && n1 == n0)
        || (after is string && existsAfter(nameDoc(after)) && getAfter(nameDoc(after)).data.acct == acct
            && n1 == (before == null ? n0 : n0 + 1) && n1 <= 2);
    }

    match /accounts/{acct} {
      allow get, delete: if isOwner(acct);
      // pscore (the prediction game's profile score) is written by the data job only
      allow create: if isOwner(acct) && !request.resource.data.keys().hasAny(['username', 'usernameChanges', 'pscore']);
      allow update: if isOwner(acct) && usernameOk(acct) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pscore']);
      match /alerts/{alert} {
        allow read, update, delete: if isOwner(acct);   // written by the data job only
      }
      // Prediction game. One open prediction per coin and period: its id is "<TICKER>_<period>", and the app can
      // only create it, never change or cancel it. The data job locks the real start price, scores it when it is
      // due and moves it to results. Both can be removed only once the account itself has been deleted.
      match /predictions/{pid} {
        allow get, list: if isOwner(acct);
        allow create: if isOwner(acct)
          && request.resource.data.keys().hasOnly(['coin', 't', 'horizon', 'target', 'createdAt', 'clientP0', 'clientSigma'])
          && request.resource.data.horizon in ['30m', '1h', '1d', '1y']
          && request.resource.data.t is string && request.resource.data.coin == 'CRYPTO:' + request.resource.data.t
          && pid == request.resource.data.t + '_' + request.resource.data.horizon
          && request.resource.data.target is number && request.resource.data.target > 0
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(acct) && !exists(/databases/$(db)/documents/accounts/$(acct));
      }
      match /results/{rid} {
        allow get, list: if isOwner(acct);
        allow delete: if isOwner(acct) && !exists(/databases/$(db)/documents/accounts/$(acct));
      }
    }
    // Which symbols anyone follows, so the data job knows what to fetch. Holds no account information.
    match /follows/{sym} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['key', 't', 'n', 'm', 'ty', 'at']);
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['key', 't', 'n', 'm', 'ty', 'at']);
    }
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && name.matches('^[a-z0-9_.]{3,20}$') && request.resource.data.keys().hasOnly(['acct', 'at'])
        && request.resource.data.acct == request.auth.uid
        && getAfter(/databases/$(db)/documents/accounts/$(request.resource.data.acct)).data.username == name;
      allow delete: if signedIn() && resource.data.acct == request.auth.uid && (!existsAfter(/databases/$(db)/documents/accounts/$(resource.data.acct))
        || getAfter(/databases/$(db)/documents/accounts/$(resource.data.acct)).data.get('username', null) != name);
    }
    // Shared lists: anyone with the long random link can read and edit.
    match /lists/{list} {
      allow get, create, update: if signedIn() && list.size() >= 20;
    }
    // AI results, written only by the AI relay (service account), readable by every signed-in user.
    match /explain/{id} { allow get: if signedIn(); }
    match /moves/{id} { allow get: if signedIn(); }
    match /indicatorDocs/{id} { allow get: if signedIn(); }
  }
}
